# Copy to .env and fill in. Values here override what is saved in Settings.
LLM_API_KEY=
# LLM_BASE_URL=https://api.ilmu.ai/v1
# LLM_MODEL=ilmu-glm-5.1

# Sign-in (optional). Leave SUPABASE_URL empty to run locally as one person, with no sign-in.
# From your Supabase project: Project Settings > API (URL) and API Keys (publishable key).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Only for projects still on the legacy JWT secret; new projects use signing keys and need nothing here.
# SUPABASE_JWT_SECRET=
# Comma-separated emails of the people running the service: they set the AI provider in Settings,
# and the first to sign in inherits the data built before sign-in was turned on.
# PLATFORM_ADMINS=you@company.com

# Hosted data (optional, with sign-in). From Supabase: Connect > Connection String > URI > Session pooler,
# with [YOUR-PASSWORD] replaced. Workspaces, members, invites and dataset/dashboard records then live in
# Postgres with row-level security; local records are copied in once on first start.
# DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres
# Project Settings > API Keys > Secret key. Server only: sends invite emails and backs up published data.
# SUPABASE_SECRET_KEY=sb_secret_...
# The address people open datawazi at, for links in invite emails (defaults to the request's address).
# PUBLIC_URL=https://app.datawazi.com
